# agent-worker environment — copy to agent-worker/.env (git-ignored; real keys never committed).
#
# LOCAL DEV LOOP (Phase LK-0):
#   1. LiveKit Cloud dashboard → project `recruitment-ai-dev` → Settings → Keys → create key.
#   2. Fill the three LIVEKIT_* values below + DEEPGRAM_API_KEY (same key backend/.env uses).
#   3. `py -3.12 -m venv .venv && .venv\Scripts\pip install -r requirements.txt`
#      (livekit-agents needs Python <= 3.12/3.13 — NOT the system 3.14).
#   4. `.venv\Scripts\python agent.py download-files`   (one-time model prefetch)
#   5. `.venv\Scripts\python agent.py dev`              (hot-reload, registers with LiveKit Cloud)
#   6. Join a room from https://meet.livekit.io (Custom tab → your LIVEKIT_URL + a token from
#      the dashboard's "Generate token" page) — the agent joins, speaks, and captions your speech.

# From the LiveKit Cloud project (dev project for local work, prod project on Render).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same Deepgram key the backend uses (STT + Aura TTS both bill to it).
DEEPGRAM_API_KEY=

# Optional in LK-0: with it set, the connection-test agent replies to what you say
# (proves the OpenRouter path); without it, you still get TTS + live captions.
OPENROUTER_API_KEY=
# OpenRouter model for the worker's renderer LLM. The real per-tenant model choice comes
# from the backend session brief in LK-2 — this is only the LK-0/LK-2 default.
AGENT_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Direct provider key (optional, and it WINS over OPENROUTER_API_KEY) ----
# Every interview turn pays the OpenRouter proxy hop, twice on turns that also carry a function
# call. That showed up in the 2026-08-05 live run as 7–15s replies, and a candidate reads a
# 15-second silence as not being heard — they asked three times. Setting this routes the worker
# straight at the provider. Mirrors the backend's VOICE_AGENT_THINK_PROVIDER escape hatch.
#
# THE TRAP: model ids are namespaced per route. OpenRouter wants "openai/gpt-4o-mini"; a direct
# OpenAI key wants "gpt-4o-mini". Set AGENT_LLM_MODEL to match whichever route is live, or the
# provider 404s every turn and the interviewer goes silent.
AGENT_LLM_API_KEY=
# Only for a non-OpenAI, OpenAI-compatible provider (Groq, Together, a local gateway). Leave
# blank for OpenAI itself.
AGENT_LLM_BASE_URL=

# Where the Node API lives, no trailing slash. From Docker on Windows/Mac use
# http://host.docker.internal:9000; on Render set the public API URL.
BACKEND_URL=http://localhost:9000

# STT/TTS models. nova-3 is the known-good default in the LiveKit Deepgram plugin;
# LK-2 switches STT to flux-general-en (the end-of-turn model) once verified live.
# TTS voice matches backend/.env DEEPGRAM_TTS_MODEL so the interviewer sounds the same
# in every pipeline.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# STT language. Worth A/B-ing against real audio rather than guessing — the transcript becomes the
# evidence a score cites, so its word error rate is not a detail. Three arms, all one restart:
#   nova-3 + en    + keyterm  — current default, strongest vocabulary biasing
#   nova-2 + en-IN + keywords — accent-matched acoustic model, weaker biasing (a real trade)
#   nova-3 + multi + keyterm  — keeps biasing, handles code-switching
# The code picks keyterm vs keywords automatically from DEEPGRAM_STT_MODEL: keyterm prompting is
# nova-3-only and the plugin raises on the wrong pairing, so do not hand-tune that part.
DEEPGRAM_STT_LANGUAGE=en

# Explicit-dispatch agent name. LEAVE UNSET for LK-0 (auto-dispatch: the worker joins any
# new room, which is what the meet.livekit.io smoke test needs). Phase LK-1 sets it
# (recruitment-interviewer) so ONLY the backend's explicit dispatch can summon the agent —
# with it set, a random room never gets an interviewer.
AGENT_NAME=
