# =============================================================================
# REQUIRED — the process exits at boot if either of these is missing.
# =============================================================================
# There are TWO separate JWT secrets and they are not interchangeable. Mixing them
# up breaks auth silently (tokens verify against the wrong key and every request 401s).
# Generate each independently:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Signs USER ACCOUNT tokens — admins, companies, candidate dashboard logins — and the
# Socket.io handshake. Used by middleware/auth.js, config/socket.js, authController.js.
AUTH_JWT_SECRET=
# Signs INTERVIEW PORTAL tokens only — the magic-link session bound to an InterviewSession,
# which has no User record at all. Used by middleware/candidateAuth.js.
JWT_SECRET=

PORT=9000
# Local: mongodb://127.0.0.1:27017/recruitment
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recruitment?retryWrites=true&w=majority&appName=<AppName>
# (database name must be in the path — Atlas' copy-paste connection string omits it)
MONGODB_URI=mongodb://127.0.0.1:27017/recruitment
# Optional. Set if mongodb+srv:// lookups fail with "querySrv ECONNREFUSED" even though
# `nslookup` resolves fine — some ISP/network resolvers work for the OS but not for Node's
# own DNS client. Comma-separated, e.g. DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=
CLIENT_ORIGIN_ADMIN=http://localhost:5173
CLIENT_ORIGIN_USER=http://localhost:5174

# The ONE base URL baked into candidate-facing emailed links (interview magic
# links, password resets, phone-cam QR). When set, it wins over the first
# CLIENT_ORIGIN_USER origin. SET THIS IN PRODUCTION to the real candidate-app
# domain — never a dev tunnel (trycloudflare etc.): only the token HASH is
# stored, so every link built from a disposable hostname dies unrecoverably
# when that hostname does.
PUBLIC_CANDIDATE_URL=

# Set to "production" to enforce prod checks (REDIS_URL required, etc.) at boot.
NODE_ENV=

# Redis. Optional in dev (emails send inline, real-time works single-instance only).
# REQUIRED in production: it's the shared backbone for the Socket.io adapter, the
# BullMQ email queue, distributed cron claims, and shared rate limiting.
REDIS_URL=

# --- Object storage (S3 / MinIO) ---
# If unset, files are stored on LOCAL DISK (backend/uploads) — fine for a single
# instance, UNSAFE across multiple instances (a file written to one isn't visible to
# the others, and ATS silently scores empty text). For self-hosted, run MinIO and set:
# REQUIRED in production, and all THREE of bucket/key/secret must be set — a partial
# config falls back to local disk exactly as an empty one does. Boot fails without them.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Must be a full URL with scheme. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com — the
# account ID, not the bucket, and no bucket in the path. A bare account ID here throws
# "TypeError: Invalid URL" on the first write. MinIO locally: http://127.0.0.1:9100 (the
# compose file maps MinIO's S3 API to :9100 because the backend owns :9000).
S3_ENDPOINT=          # leave empty for AWS S3
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=  # set to "true" for MinIO and R2
# Escape hatch for a production host with genuinely persistent disk (a VPS with a
# mounted volume, not a container platform). Downgrades the S3 boot error above to a
# warning. Leave unset on Render/Fly/Heroku — their filesystems are wiped on restart,
# and the resulting failure is not a missing file: screening then extracts empty text
# and scores the candidate on nothing.
ALLOW_LOCAL_STORAGE=

# ---- Graceful shutdown ----
# Apply/rescore/interview-finalisation answer the HTTP request and finish the real work
# afterwards. On SIGTERM those detached tasks get SHUTDOWN_DRAIN_MS to complete before
# Mongo is disconnected; anything still running is logged BY NAME (candidate/session id)
# so it can be re-run, never dropped silently. SHUTDOWN_TIMEOUT_MS is the hard stop for
# the whole sequence and must exceed the drain with room for socket/worker/Mongo
# teardown. Both must fit the platform's SIGTERM->SIGKILL window (Render allows ~30s).
SHUTDOWN_DRAIN_MS=15000
SHUTDOWN_TIMEOUT_MS=25000

# ---- Scheduled jobs ----
# IANA timezone for every node-cron schedule (retention purge, calibration, subscription
# expiry, publish reconcile). Defaults to UTC so a laptop and a container agree; without
# it node-cron follows the container clock and "daily at 03:00" means a different hour in
# each environment. Set e.g. Asia/Kolkata to move them all together.
CRON_TIMEZONE=UTC

# --- Scaling / workers ---
# On multi-instance production: set this to "false" on the API instances and run ONE
# `npm run worker` process, so cron jobs fire exactly once (no duplicate emails).
# Leave unset/true for single-instance dev/pilot (API runs the workers itself).
RUN_WORKERS_IN_API=

# Tenant-isolation guardrail: set "true" in staging/CI to make any tenant-scoped query
# that runs WITHOUT a tenant context throw (surfaces missing-scope bugs). Leave unset in
# production so legitimate public/candidate/system queries aren't blocked.
TENANT_GUARD_STRICT=

# Optional: how many days before a subscription's currentPeriodEnd the
# expiry-reminder cron job should start notifying the company admin.
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=7

# Grace window after currentPeriodEnd (Phase 11.2): the tenant keeps full
# access for this many days (with warnings), then the subscription flips to
# "expired" and the workspace becomes READ-ONLY (mutations blocked with code
# SUBSCRIPTION_EXPIRED; jobs stop accepting applications). Never data lockout.
SUBSCRIPTION_GRACE_DAYS=7

# --- Auth: access + refresh tokens (W5 §5.1) ---
# Access tokens are short-lived; the frontends silently exchange the refresh token for a
# new pair via POST /api/auth/refresh (rotation + reuse-detection). Access TTL accepts any
# jsonwebtoken duration string (e.g. 15m, 2h). Refresh TTL is in days.
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=30

# Gates POST /api/auth/admin/register, which creates a SUPERADMIN account. The request must
# send a matching `x-admin-signup-key` header. Fails closed: if this is unset, no superadmin
# can be bootstrapped at all. Set it, create the account, then unset it again.
ADMIN_SIGNUP_KEY=

# --- Email (SMTP) ---
# REQUIRED IN PRODUCTION. If SMTP_HOST is unset, utils/mailer.js falls back to nodemailer's
# jsonTransport: mail is composed, EmailLog rows are marked "sent", the UI reports success —
# and nothing is ever delivered. Locally that is the intended dev behaviour (the full body is
# printed to the log so you can copy a verification link or OTP out of it), but a production
# boot with no SMTP_HOST now fails validateEnv rather than silently dropping every email.
# This is the #1 cause of "the OTP/verification email never arrived".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=          # "true" for implicit TLS on port 465; leave empty for STARTTLS on 587
SMTP_USER=            # leave empty for an unauthenticated relay
SMTP_PASS=
# Envelope From. Defaults to no-reply@recruitment.local — an unroutable domain that most
# receiving servers reject or spam-file, so set a real address on any deploy that sends mail.
# Brevo gotcha: do NOT use the SMTP_USER login (the auto-generated xxxx@smtp-brevo.com) as
# MAIL_FROM — it isn't a real sender identity. Brevo will accept the SMTP send (no error,
# EmailLog shows "sent") and then reject it downstream: "the sender you used ... is not
# valid". Use a sender verified under Brevo → Senders, domains, IPs instead.
MAIL_FROM=

# --- Payments (Razorpay) ---
# Without KEY_ID/KEY_SECRET, checkout returns 503 and the admin UI renders "Payments Coming
# Soon" (a designed fallback, not a bug). WEBHOOK_SECRET is separate and is verified against
# the raw request body — without it EVERY webhook fails signature verification and returns 400,
# so payments never provision a workspace.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Billing enforcement (utils/billingMode.js) — DEMO / PILOT ESCAPE HATCH ---
# Set to the literal "off" to lift the two subscription gates: the login paywall
# (403 PAYMENT_REQUIRED -> /pricing) and the per-request requireActiveCompany check
# (403 COMPANY_INACTIVE). A company then reaches a fully provisioned workspace —
# Subscription + Workspace + CompanySettings — without any payment, which is what
# lets the product be demoed with no Razorpay account configured.
#
# Fail-safe: ONLY the exact value "off" disables enforcement. Unset, empty, "false"
# or a typo all keep the paywall up.
#
# NOTE: this also stops TENANT SUSPENSION from being enforced — a suspended company's
# admin can log in while it is on. Suspended tenants keep their status on disk, so
# removing this var and restarting restores every lockout exactly as it was. Nothing
# to migrate, nothing to undo.
BILLING_ENFORCEMENT=
# Plan attached to workspaces auto-provisioned by the bypass above. Defaults to
# "enterprise" (effectively unlimited) so a demo never hits a tier quota. Ignored
# entirely when BILLING_ENFORCEMENT is not "off".
DEMO_PLAN_KEY=enterprise

# --- Interview scheduling tunables (services/interviewInvitationService.js) ---
# How far ahead an ATS-passed candidate's interview is scheduled, at what UTC hour, and how
# long the magic link stays valid. Defaults shown.
INTERVIEW_SCHEDULE_DELAY_DAYS=3
INTERVIEW_SCHEDULE_HOUR_UTC=11
INTERVIEW_LINK_VALIDITY_HOURS=48

# --- Assessment engine (ASSESSMENT-ENGINE-PLAN) ---
# Gate 1 of 4 (env → tenant setting → Job.assessmentPolicy [default off] → per-candidate
# recruiter assignment). Enabled by default; nothing runs until a recruiter turns a job's
# policy on AND assigns a candidate. Set false to unmount all assessment routes.
ASSESSMENT_ENGINE_ENABLED=true
# A3 claim loop (targeted assembly, verdict write-back, post_assessment rescore, probe
# dedup). false ⇒ pure A2 behaviour (uniform assembly, no write-back).
ASSESSMENT_CLAIM_LOOP_ENABLED=true
# Link validity from assignment (start deadline defaults to the same window; both
# overridable per job).
ASSESSMENT_LINK_VALIDITY_HOURS=72
# Item generation caps — the one-time authoring cost is bounded by these plus the
# tenant's monthly AI budget. Blind solvers per item (N) and per-paper ceilings.
ASSESSMENT_SOLVER_N=3
ASSESSMENT_MAX_ITEMS_PER_PAPER=60
ASSESSMENT_MAX_GEN_CALLS_PER_PAPER=400
ASSESSMENT_POOL_CAP_PER_TIER=8
# Liveness window for an item-generation run. A run whose heartbeat goes quiet
# for longer than this is treated as dead and may be taken over; unset ⇒ 15 min.
# Too low and two loops can land on the same paper; too high and a crashed run
# wedges the paper until the window elapses.
ASSESSMENT_GEN_STALE_MS=900000
# Soft-lock fail-open: minutes a paused assessment waits for a human before auto-RESUMING.
ASSESSMENT_SOFTLOCK_AUTORESUME_MIN=3

# --- Round scorecards (human interview rounds) ---
# Mounts /api/scorecards + /api/scorecard-portal. Independent of the assessment
# engine flag — the three human rounds exist either way. Default OFF.
SCORECARD_ENGINE_ENABLED=true
# How long a panelist's magic link stays valid. Re-sending rotates the token.
SCORECARD_VALIDITY_HOURS=72
# Points of human/engine gap that raise a `scorecard_disagreement` alert. The gap
# is never averaged away — it routes to a person (rule 4).
SCORECARD_DISAGREEMENT_ALERT=25

# --- Outbound mail formatting ---
# IANA zone used to render dates/deadlines in emails and notification text.
# Unset ⇒ Asia/Kolkata, so a US or EU tenant would show every deadline in IST.
MAIL_TIMEZONE=Asia/Kolkata

# --- HTTP hardening (W5 / F12) ---
# Max JSON body size (resumes/photos are multipart via multer, not JSON, so this stays small).
JSON_BODY_LIMIT=1mb
# Socket-level request/header timeouts in ms (Slowloris protection). headers must exceed request.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000

# --- DPDP data retention (W5 §5.2) ---
# The nightly retention job hard-deletes candidate PII (resume, identity photo, interview
# transcript, queue, usage) once a candidate is untouched longer than the tenant's
# CompanySettings.compliance.retentionDays. Set to "false" to disable the destructive job;
# RETENTION_MAX_PER_RUN caps how many candidates are purged per tenant per nightly run.
RETENTION_JOB_ENABLED=
RETENTION_MAX_PER_RUN=500

# --- Performance & observability (W6) ---
# Mongo connection pool + timeouts (config/db.js). Defaults suit a single-VPS pilot; raise
# maxPoolSize as instance count / replica-set size grows, but keep N×maxPoolSize under mongod's
# connection cap. serverSelectionTimeout fails fast when Mongo is unreachable.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=60000
# Build indexes on boot? Defaults to true in dev, false in production (NODE_ENV=production).
# When false, run `npm run sync:indexes` on deploy instead of blocking startup on index builds.
MONGO_AUTO_INDEX=
# Structured logs: level = debug|info|warn|error (default info). LOG_PRETTY=true for
# human-readable dev output instead of one-JSON-object-per-line.
LOG_LEVEL=info
LOG_PRETTY=
# GET /metrics (Prometheus) is open when this is unset; set a token to require
# `Authorization: Bearer <token>` on scrapes (recommended on a public VPS).
METRICS_TOKEN=
# Load-test SLO gate (scripts/loadTest.js). The run exits non-zero if any is exceeded.
SLO_P95_MS=500
SLO_P99_MS=1000
SLO_ERROR_RATE_PCT=1
# Load-test target + shape (scripts/loadTest.js). All three are also overridable by CLI flag.
LOADTEST_URL=
LOADTEST_CONCURRENCY=
LOADTEST_DURATION=

# --- AI Interview Engine (OpenRouter) ---
# OpenRouter API key for the AI interviewer + evaluation (services/llmService.js).
# If unset, the interview engine runs in DETERMINISTIC FALLBACK mode: it still
# conducts a text interview and produces a heuristic report, but questions are
# from a fixed bank and the evaluation is completeness-based rather than a real
# qualitative assessment. Set this to enable the model-powered interviewer.
OPENROUTER_API_KEY=
# Model slug from https://openrouter.ai/models (e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001). Pick one that
# supports structured outputs (JSON schema). Defaults to openai/gpt-4o-mini.
AI_INTERVIEW_MODEL=openai/gpt-4o-mini
# Optional: override the API base URL (defaults to https://openrouter.ai/api/v1).
OPENROUTER_BASE_URL=
# Optional LLM reliability tunables (services/llmService.js).
# LLM_TIMEOUT_MS covers short interactive calls (interview turns, critic, probes).
# LLM_TIMEOUT_HEAVY_MS covers extraction-class calls that stream thousands of JSON
# tokens — ClaimGraph extraction and rubric x claim matching. Those measure ~75s on
# a normal résumé, so they must NOT inherit the 30s interactive ceiling: when they
# did, every evidence-engine run aborted mid-stream and silently degraded to the
# legacy keyword scorer.
LLM_TIMEOUT_MS=30000
LLM_TIMEOUT_HEAVY_MS=180000
LLM_MAX_RETRIES=2
# Per-role model pins for the registry (config/models.js). Business code resolves
# models by role (interview/extraction/reasoning/cheap) — never a bare string —
# so a model swap is always an explicit, auditable config change.
LLM_MODEL_EXTRACTION=
LLM_MODEL_REASONING=
LLM_MODEL_CHEAP=
# Deterministic response cache (services/llmCache.js): re-running an unchanged
# request returns the identical result and spends nothing. Keyed by model +
# promptVersion + full prompt, so prompt edits invalidate cleanly. On by
# default; set to false to roll back (BUILD-PLAN Phase 2). Uses Redis when
# REDIS_URL is set, otherwise an in-process LRU.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_S=604800
LLM_CACHE_MAX_ENTRIES=500
# Circuit breaker: after LLM_BREAKER_THRESHOLD consecutive provider failures the
# service fails fast to the deterministic fallback for the cooldown window
# instead of burning retries x timeout per request. State on GET /metrics
# (llm_breaker_state: 0 closed / 1 half-open / 2 open).
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=60000
# Credit exhaustion (provider HTTP 402) is handled separately from the breaker:
# it is not provider sickness and no retry clears it, so the first 402 latches
# and later calls fail fast with code LLM_NO_CREDITS until someone tops the
# account up. One request per cooldown is let through to detect that top-up, so
# recovery needs no restart. Visible on GET /metrics (llm_credits_exhausted).
LLM_NO_CREDITS_COOLDOWN_MS=300000
# N-way ensemble sampling (generateJSONEnsemble). OFF by default because cost is
# N x per call — enable only where the QA gate needs an agreement signal.
LLM_ENSEMBLE_ENABLED=false
LLM_ENSEMBLE_MAX_N=5
# Record/replay for CI (Phase 1.6): LLM_RECORD=1 persists live responses as
# fixtures; LLM_REPLAY=1 serves them with zero network. Leave unset in prod.
LLM_RECORD=
LLM_REPLAY=
LLM_FIXTURES_DIR=
# Rubric Compiler (BUILD-PLAN Phase 3, services/rubricService.js). On by
# default; set to false to stop all rubric compilation (rollback flag). Existing
# rubrics stay readable — only compile/supersede stops.
RUBRIC_ENGINE_ENABLED=true
# Hostile-input defence (Phase 4, services/resumeDefenseService.js). On by
# default — deterministic, no LLM cost. false = empty hostility report,
# extraction proceeds exactly as before (rollback flag). It FLAGS, never
# decides: no score or stage ever changes because of it.
RESUME_DEFENSE_ENABLED=true
# Claim extraction engine (Phase 5, services/claimService.js). false = the
# evidence pipeline never extracts claims; the ATS falls back to the legacy
# keyword engine (rollback flag).
CLAIM_ENGINE_ENABLED=true
# Application autofill (services/autofillService.js) — résumé → SUGGESTED form
# fields, each carrying the verbatim span it came from, which the candidate must
# review before submitting. false = the apply form behaves exactly as it did
# before (rollback flag); candidates fill it in by hand. Degrades on its own when
# no LLM key is configured: contact details only, LABELLED as a partial parse.
# Suggestions are never a decision and never a score — they are proposals.
AUTOFILL_ENABLED=true
# Evidence-bound ATS engine (Phase 6). legacy = keyword engine only (today's
# behaviour) · shadow = run BOTH, log the evidence assessment, behave on legacy
# (the mandatory soak mode) · live = evidence engine drives decisions, legacy
# remains the labelled fallback. Per-tenant override: CompanySettings.ai.atsEngine.
ATS_ENGINE=legacy
# QA gate over evidence assessments (Phase 7). off = skip · monitor = compute
# and log gate outcomes without changing routing · enforce = gate outcomes
# route candidates (review band, human queue). Run monitor before enforce.
ATS_QA_GATE=monitor
# Fraction of live assessments that get the counterfactual bias re-check
# (Phase 7.4); CI always runs it at 100%.
QA_COUNTERFACTUAL_SAMPLE_RATE=0.05
# Calibration display gates (Phase 10): minimum decided outcomes overall / per
# score bin before a calibrated probability is SHOWN. Below these the UI shows
# nothing rather than a fake-precise percentage.
CALIBRATION_MIN_TOTAL=30
CALIBRATION_MIN_BIN=5
# Claim → Probe → Verdict loop (Phase 8, services/probeService.js). false = no
# probes are generated, the interview runs exactly as before, and no
# post-interview rescore happens (rollback flag). Probes only ever exist for
# candidates the evidence engine assessed (shadow/live + approved rubric).
PROBE_ENGINE_ENABLED=true
# Optional: ranking headers for OpenRouter's app leaderboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# ---- Voice interview (Deepgram) — services/speechService.js ----
# Enables the real-time VOICE interview (streaming STT + Aura TTS). If unset, the
# interview stays text-typed and GET /interview-portal/voice/token returns 503.
# The key stays server-side; the backend mints short-lived browser tokens from it.
DEEPGRAM_API_KEY=
# Streaming speech-to-text model. nova-3 is needed for BOTH utterance-end turn detection and
# keyterm prompting — the vocabulary biasing that keeps technical nouns from being mangled
# ("Kubernetes" -> "cooper netties"). On nova-3 the terms are sent as `keyterm=`; on earlier
# models speechService falls back to the older `keywords=` param, which is weaker. The terms
# themselves are derived deterministically from the role + the candidate's span-verified skill
# claims (utils/keyterms.js) — nothing to configure, and the list used is recorded on the session.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
# Silence (ms) after the last word before an answer's turn auto-ends (hands-free turn-taking).
# Higher = more tolerant of thinking pauses (won't cut the candidate off); lower = snappier.
# 2000 was tuned for chat and cut candidates off mid-thought; 3200 is the code default and the
# client adds its own visible grace window on top (see useVoiceInterview.js).
DEEPGRAM_UTTERANCE_END_MS=3200
# Aura-2 TTS voice for spoken questions ([model]-[voice]-[lang], e.g. aura-2-thalia-en).
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Voice cost attribution (Phase 9.4): estimated cents per unit used to meter
# stt/tts UsageEvent rows against the tenant budget. Estimates, not invoices —
# tune to your Deepgram contract.
DEEPGRAM_TTS_CENTS_PER_1K_CHARS=1.5
DEEPGRAM_STT_CENTS_PER_MIN=0.77
# TTL (seconds) of the short-lived browser streaming token (max 3600; ~60s is plenty).
VOICE_TOKEN_TTL_SECONDS=60

# ---- Conversational interviewer (utils/backchannel.js) ----
# Silence is handled as a conversation, not a deadline: when a candidate goes quiet the
# interviewer says "take your time — I'm here" and waits considerably longer, and only treats
# silence as the end of the turn once this budget is spent. The WORDS are a fixed, human-approved
# bank in code — never model-generated — so they are not configurable here; only the patience is.
# Set to 0 to disable reassurance and restore the old pause-ends-your-turn behaviour.
VOICE_MAX_REASSURANCES=2
# How long to wait after saying "take your time" before acting on silence again. Keep this
# generous: a short window makes the offer of time a lie.
VOICE_POST_REASSURANCE_GRACE_MS=9000
# Silence after a question, BEFORE the candidate has said anything at all — the case the pipeline
# used to handle worst (it waited indefinitely, in total silence).
VOICE_INITIAL_SILENCE_MS=6000
# ---- Semantic endpointing (utils/endpointing.js) ----
# When has the candidate finished? Not a question about duration, which is why the old flat timer
# kept being raised and kept getting it wrong in both directions. The waiting window is now chosen
# from the SHAPE of what was just said: trailing on "and…" or a filler waits generously; a
# completed sentence with the voice falling away gets a reply in under a second.
# Ending a turn early destroys evidence; waiting too long merely feels slow — so every ambiguous
# case waits. Raise these to be more patient; the floor is what stops candidates being cut off.
VOICE_ENDPOINT_COMPLETE_MS=900
VOICE_ENDPOINT_AMBIGUOUS_MS=1800
VOICE_ENDPOINT_HOLDING_MS=4500
# Below this many words an answer is treated as ambiguous however it ends — "Yes." is a complete
# sentence and almost never a complete answer.
VOICE_ENDPOINT_MIN_WORDS=8

# ---- Explicit "that's my answer" (utils/finishIntent.js) ----
# The candidate saying outright that they are done — the fastest end-of-turn signal there is.
# Honoured only as the tail of a substantive answer: on its own, "that's it" is far more likely to
# be a sentence still forming than a hand-back.
VOICE_FINISH_MIN_ANSWER_WORDS=12
VOICE_FINISH_MAX_TRAILING_WORDS=2

# Before a turn actually ends, the interviewer asks "Anything you'd like to add?" and waits this
# long for a reply. Candidates consistently report the timer-only ending as being cut off
# mid-thought; asking hands the decision back to them for a few seconds rather than the fixed
# minute-long wait that would otherwise be needed to feel unhurried. Any new speech cancels the
# ending outright. Offered at most once per turn.
VOICE_CONFIRM_GRACE_MS=5000

# ---- Spoken-vs-authored verification (utils/speechAuthorization.js) ----
# Every word the interviewer speaks goes through one endpoint, so that endpoint checks the text
# against a closed set: interviewer turns already in this session's transcript (authored by the
# rubric-bound engine) plus the fixed approved phrase bank. Anything else is recorded verbatim on
# the session and refused — which is what lets you answer "what did the interviewer say to this
# candidate?" with evidence rather than a shrug. Leave this on. Set to "false" only to diagnose an
# unexpected mismatch (divergences are still recorded, just not blocked).
VOICE_SPEECH_STRICT=true

# ---- Repeat-on-request (utils/repeatIntent.js) ----
# A candidate can say "sorry, could you repeat that?" and hear the question again — the same
# authored text, in fact the same audio bytes, never a regenerated question. The repeat COUNT is
# recorded on the question turn and is structurally excluded from every score: it correlates with
# accent, hearing and connection quality far more than with ability, so scoring it would build a
# disparate-impact machine. Set the max to 0 to disable the feature entirely.
VOICE_MAX_REPEATS_PER_QUESTION=3
# A request is only honoured while the candidate has said nothing substantive yet. Past this many
# leftover words we assume they are mid-answer and leave their words alone — silently discarding a
# real answer to be helpful is the worse failure.
VOICE_REPEAT_MAX_CARRY_WORDS=6

# ---- Interviewer persona fallback (services/personaService.js) ----
# Used ONLY when a tenant has approved no PersonaProfile of its own (POST /api/personas +
# /:id/approve). Sessions that fall back are stamped `persona.source: "default"` so a fallback is
# never mistaken for a configured choice. A tenant's approved persona overrides all three.
VOICE_PERSONA_DEFAULT_NAME=Ava
VOICE_PERSONA_DEFAULT_PROVIDER=deepgram
# Empty ⇒ use DEEPGRAM_TTS_MODEL above. Set to pin the fallback interviewer to a specific voice.
VOICE_PERSONA_DEFAULT_VOICE=

# ---- Integrity evidence (Phase 14) ----
# Event-anchored evidence clips: the browser keeps a ~15s in-memory rolling
# buffer and persists a clip ONLY when a high-severity proctoring event fires
# (multi_face, identity_mismatch, sustained face_absent, phone_cam_lost) —
# consent-gated, server-capped per session, purged with the candidate. false =
# exactly the pre-Phase-14 counts-only behaviour. Per-tenant override:
# CompanySettings.proctoring.evidenceClips.
EVIDENCE_CLIPS_ENABLED=false
# Secondary phone camera: QR pairing, in-browser vision on the phone, presence
# heartbeat (NO continuous streaming). Per-tenant override:
# CompanySettings.proctoring.secondaryCam.
SECONDARY_CAM_ENABLED=false
# Server-enforced cap on clips per session (the 7th upload is rejected at 6).
EVIDENCE_MAX_CLIPS_PER_SESSION=6
# Phone heartbeat silence (ms) after which the laptop's next event flush raises
# a phone_cam_lost flag. Phone heartbeats every ~10s.
PHONE_HEARTBEAT_TIMEOUT_MS=12000

# ---- Sales / marketing (Phase 13) ----
# Where "Request a Demo" leads are emailed. Leads are always persisted to the
# DemoRequest collection regardless; if this is unset, no email goes out.
SALES_NOTIFY_EMAIL=

# ---- Distribution (Phase 15) ----
# Public base URL of THIS backend — used in careers-page links, feed URLs, and
# JSON-LD canonical URLs. Set to the real domain in production or Google for
# Jobs will index localhost links.
PUBLIC_BASE_URL=http://localhost:9000
# Public careers pages + aggregator feeds (/careers/:slug, /feeds/:slug/…).
# false = those routes 404. Per-tenant override: CompanySettings.careers.enabled.
CAREERS_PAGES_ENABLED=true
# Multi-board publishing (connector framework, publish queue, credentials UI).
# false = publish endpoints 403. Per-tenant override: CompanySettings.publishing.enabled.
JOB_PUBLISHING_ENABLED=true
# Nightly reconcile of published listings (status re-check + expiry). false = off.
PUBLISH_RECONCILE_ENABLED=true
# 64 hex chars (32 bytes) — AES-256-GCM key for tenant board credentials
# (Naukri etc.). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset ⇒ credential saves fail with 503 BOARD_CREDS_UNCONFIGURED; nothing else breaks.
BOARD_CRED_ENC_KEY=
# Tier B/C board API bases — defaults point at .example hosts (fixtures); set
# real endpoints only when the board integration goes live.
NAUKRI_API_BASE=
LINKEDIN_API_BASE=
INDEED_API_BASE=
ZIPRECRUITER_API_BASE=
# Tier C partner integrations ship DISABLED until partner approval lands
# (the applications are an owner action; the code is never the blocker).
LINKEDIN_PARTNER_ENABLED=false
INDEED_PARTNER_ENABLED=false
ZIPRECRUITER_PARTNER_ENABLED=false

# ---- Platform console (Phase 16) ----
# Superadmin-only /api/platform/* (tenant directory, AuditLog/EmailLog/UsageEvent
# viewers, AI trust dashboard). false = every platform route 404s (rollback flag).
PLATFORM_CONSOLE_ENABLED=true
# Optional comma-separated IP allowlist for the platform console; empty = any IP
# (the superadmin role + rate limit still gate every request).
PLATFORM_IP_ALLOWLIST=
